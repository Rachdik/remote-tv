<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Pairing identity and paired devices are device-bound and are not backed up. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
