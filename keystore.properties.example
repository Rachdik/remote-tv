# Copy to keystore.properties to sign release builds with your own key.
# Generate one with:
#   keytool -genkeypair -v -keystore universal-tv-remote.jks -alias universal-tv-remote \
#     -keyalg RSA -keysize 2048 -validity 10000
storeFile=universal-tv-remote.jks
storePassword=change-me
keyAlias=universal-tv-remote
keyPassword=change-me
